# Copy to .env and fill in. .env is gitignored; .env.example is not.

# Zone-scoped token used only to purge the cache after a deploy. Optional —
# without it the deploy still succeeds and just skips the purge.
# Permissions: Zone → Cache Purge → Purge
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ZONE_ID=""

# Account-scoped token used by utils/deploy/add-tunnel-hostname.sh to publish
# omgstop.org on the Cloudflare Tunnel. This is a DIFFERENT permission set from
# the purge token above; if one token carries all four, set it here and leave
# CLOUDFLARE_API_TOKEN empty (the script falls back to this one).
#
# Permissions required:
#   Account → Cloudflare Tunnel → Edit    (write the tunnel ingress rules)
#   Account → Cloudflare Tunnel → Read    (read them back before merging)
#   Zone    → DNS → Edit                  (create the omgstop.org CNAME)
#   Zone    → Zone → Read                 (look the zone up by name)
# Zone Resources: include omgstop.org (or All zones)
CLOUDFLARE_TUNNEL_API_TOKEN=""

# Optional: force a specific SSH key for the deploy. Without it, deploy.sh
# falls back to ssh-agent, then ~/.ssh/id_ed25519, then ~/.ssh/id_rsa.
# SSH_KEY_PATH="$HOME/.ssh/id_ed25519"
