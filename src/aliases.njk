---
pagination:
  data: collections.peeveAliases
  size: 1
  alias: entry
permalink: "/{{ entry.slug }}/index.html"
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{{ entry.title }} – {{ site.name }}</title>
    {# Canonical points at the real page so search engines and link unfurlers
       treat the aliases as the same thing rather than duplicate content. #}
    <link rel="canonical" href="{{ site.url }}{{ entry.target }}/" />
    <meta http-equiv="refresh" content="0; url={{ entry.target }}/" />
    <meta name="robots" content="noindex, follow" />
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    {# The meta refresh is the guarantee; this just makes it instant and keeps
       the alias out of the back-button history. #}
    <script>
      location.replace({{ (entry.target + "/") | dump | safe }});
    </script>
    <div class="notfound">
      <p class="notfound__code">Redirecting</p>
      <h1 class="notfound__title">
        <a href="{{ entry.target }}/">{{ entry.title }}</a>
      </h1>
    </div>
  </body>
</html>
