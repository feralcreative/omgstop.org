---
layout: layouts/base.njk
permalink: /index.html
eleventyExcludeFromCollections: true
---

<div class="home">
  <header class="home__head">
    <h1 class="home__title">OMG<br /><span>STOP</span></h1>
    <p class="home__tagline">{{ site.tagline }}</p>
  </header>

  {% set peeves = collections.peeves %}
  {% if peeves.length %}
  <ul class="peeve-list">
    {% for peeve in peeves %}
    <li class="peeve-list__item">
      <a class="peeve-list__link" href="{{ peeve.url }}">
        <h2 class="peeve-list__title">
          {{ peeve.data.title }}
          <span class="peeve-list__slug">omgstop.org{{ peeve.url | prettyUrl }}</span>
        </h2>
        {% if peeve.data.summary %}
        <p class="peeve-list__summary">{{ peeve.data.summary }}</p>
        {% endif %}
      </a>
    </li>
    {% endfor %}
  </ul>
  {% else %}
  <p class="home__empty">Nothing yet. Give it a week.</p>
  {% endif %}
</div>
