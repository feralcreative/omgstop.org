---
layout: layouts/base.njk
---

{# Fallacy examples are quoted arguments, not misspellings, so they get a
   different treatment for the "wrong" line—see .peeve--argument in the CSS. #}
<article class="peeve{% if category == 'Logical fallacies' %} peeve--argument{% endif %}">
  <header class="peeve__head">
    {% if category %}<p class="peeve__eyebrow"><a href="/{{ categories[category].slug }}/">{{ categories[category].heading }}</a></p>{% endif %}
    <h1 class="peeve__title">{{ title | smartquotes }}</h1>
    {% if summary %}<p class="peeve__summary">{{ summary | smartquotes }}</p>{% endif %}
  </header>

  {% if rule %}
  <aside class="rule" aria-label="The short version">
    <p class="rule__label">The short version</p>
    {# `safe` because rule intentionally carries <em>/<b>; smartquotes skips
       anything inside a tag, so the markup survives the conversion. #}
    <p class="rule__body">{{ rule | smartquotes | safe }}</p>
  </aside>
  {% endif %}

  {# Examples live in front matter rather than the body so every peeve renders
     them identically and writing a new one stays a copy-paste job. #}
  {% if examples %}
  <section class="examples" aria-label="Examples">
    <ul class="examples__list">
      {% for ex in examples %}
      <li class="example">
        <p class="example__line example__line--wrong">
          <span class="example__mark" aria-hidden="true">✗</span>
          <span class="visually-hidden">Wrong:</span>
          <span class="example__text">{{ ex.wrong | smartquotes }}</span>
        </p>
        <p class="example__line example__line--right">
          <span class="example__mark" aria-hidden="true">✓</span>
          <span class="visually-hidden">Right:</span>
          <span class="example__text">{{ ex.right | smartquotes }}</span>
        </p>
        {% if ex.note %}<p class="example__note">{{ ex.note | mdInline | safe }}</p>{% endif %}
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  <div class="prose">{{ content | safe }}</div>

  {% if snark %}<p class="peeve__snark">{{ snark | smartquotes }}</p>{% endif %}

  {# Straight after the sign-off: the reader has just been told someone is
     wrong, and this is the moment they want the link. #}
  {% include "partials/share.njk" %}

  {% set siblings = collections.peeves | related(page.url, category, order, 4) %}
  {% if siblings.length %}
  <nav class="related" aria-label="More in {{ category }}">
    <h2 class="related__label">More {{ category | lower }}</h2>
    <ul class="related__list">
      {% for peeve in siblings %}
      <li>
        <a href="{{ peeve.url }}">{{ peeve.data.title | smartquotes }}</a>
      </li>
      {% endfor %}
    </ul>
  </nav>
  {% endif %}

  <nav class="peeve__nav">
    <a class="button" href="/">See the rest of them</a>
  </nav>
</article>
