<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{% if title %}{{ title }} – {{ site.name }}{% else %}{{ site.name }}{% endif %}</title>
    <meta name="description" content="{{ summary or site.description }}" />

    {# These matter more than usual: the whole point is sending the link to
       someone, and an unfurled preview in Slack does half the arguing. #}
    <meta property="og:site_name" content="{{ site.name }}" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="{{ title or site.name }}" />
    <meta property="og:description" content="{{ summary or site.description }}" />
    <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="{{ title or site.name }}" />
    <meta name="twitter:description" content="{{ summary or site.description }}" />

    <link rel="canonical" href="{{ site.url }}{{ page.url }}" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="masthead">
      <a class="masthead__logo" href="/">
        <span class="masthead__omg">OMG</span><span class="masthead__stop">STOP</span>
      </a>
    </header>

    <main id="main">{{ content | safe }}</main>

    <footer class="colophon">
      <p>
        <a href="/">All of them</a> · Somebody had to say it.
      </p>
    </footer>
  </body>
</html>
