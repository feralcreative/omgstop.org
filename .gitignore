# Build output — regenerated by `npm run build`, never committed.
_site/

# Dependencies
node_modules/

# Secrets. .env.example is tracked; .env is not.
.env

# macOS / editor cruft
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
*.swp
*~

# Editor settings, except .vscode/sftp.json — CI reads the deploy target out of
# it, so that one file has to stay tracked.
.vscode/*
!.vscode/sftp.json

# Logs
*.log
npm-debug.log*

# Sass
.sass-cache/
*.css.map
